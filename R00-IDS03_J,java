*/

// COMPLIANT SOLUTION
if (loginSuccessful) {
    logger.severe("User login succeeded for: " + sanitizeUser(username)); [cite: 79]
} else {
    logger.severe("User login failed for: " + sanitizeUser(username)); [cite: 83]
}

public String sanitizeUser(String username) {
    return Pattern.matches("[A-Za-z0-9]+", username) ? username : "unauthorized user"; [cite: 85, 86]
}
